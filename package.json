{
  "name": "oa-file-hider",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --platform=browser --target=es2017 --outfile=dist/main.js",
    "deploy": "npm run build && cp dist/main.js manifest.json \"${OBSIDIAN_PLUGIN_DIR:?set OBSIDIAN_PLUGIN_DIR to the plugin folder}/\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  }
}
